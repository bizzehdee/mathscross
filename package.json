{
  "name": "mathscross",
  "version": "0.0.0",
  "description": "Offline-first maths crossword PWA with seeded puzzle generation",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "vite build --config vite.cordova.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slow": "vitest run --config vitest.slow.config.ts"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  },
  "private": true
}
